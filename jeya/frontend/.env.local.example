# Backend manzillari (haqiqiy backend bilan ishlaganda)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Demo rejimi: backend (FastAPI/Claude API) bo'lmasdan platformani sinash uchun.
